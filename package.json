{
  "name": "liveloot",
  "productName": "LiveLoot",
  "version": "1.0.0",
  "description": "LiveLoot - widgets and lucky wheel for TikTok LIVE",
  "author": "Liroy",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "express": "^5.3.0",
    "msedge-tts": "^2.1.1",
    "socket.io": "^4.8.4",
    "tiktok-live-connector": "^2.5.0"
  },
  "devDependencies": {
    "electron": "39.8.10",
    "electron-builder": "26.0.12",
    "resedit": "^2.0.3"
  },
  "build": {
    "appId": "gg.liveloot.app",
    "productName": "LiveLoot",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "server.js",
      "public/**/*",
      "sounds/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "LiveLoot",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerLanguages": [
        "he_IL",
        "en_US"
      ],
      "artifactName": "LiveLoot-Setup-${version}.${ext}"
    },
    "afterPack": "build/afterPack.js"
  }
}